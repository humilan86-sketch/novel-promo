#!/bin/bash
# 双击 App：启动本地控制台并打开浏览器；已在运行则直接打开浏览器
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR" || exit 1
mkdir -p .cache
LOG=".cache/console.log"

if curl -s -m 2 -o /dev/null http://127.0.0.1:8765/; then
  open "http://127.0.0.1:8765/"
  exit 0
fi

if [ ! -x ".venv/bin/python" ]; then
  osascript -e 'display alert "还没安装运行环境" message "请在项目目录执行：python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt"'
  exit 1
fi

nohup ./.venv/bin/python -m novelauto web --port 8765 --no-browser >> "$LOG" 2>&1 &
echo $! > .cache/console.pid

for i in $(seq 1 40); do
  sleep 0.5
  if curl -s -m 1 -o /dev/null http://127.0.0.1:8765/; then
    open "http://127.0.0.1:8765/"
    exit 0
  fi
done

osascript -e 'display alert "控制台启动失败" message "看 .cache/console.log 里的报错"'
exit 1

# 复制成 .env 后填写。没有 LLM Key 也能跑（离线改写），但文案质量会明显下降。

# —— 大模型（OpenAI 兼容接口，默认 DeepSeek）——
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# —— 火山引擎豆包 TTS（TTS_PROVIDER=volc 时用）——
VOLC_APPID=
VOLC_TOKEN=
VOLC_CLUSTER=volcano_tts

# —— MiniMax TTS（TTS_PROVIDER=minimax 时用）——
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 临时覆盖配置（一般不用改）
# TTS_PROVIDER=edge
